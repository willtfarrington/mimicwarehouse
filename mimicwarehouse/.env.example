# mimicwarehouse settings — template (EP-3, mimicwarehouse.config.Settings).
#
#   copy .env.example .env      # in this folder (mimicwarehouse/); .env is gitignored
#
# Precedence: `mwh --data-root` / init kwargs > MWH_* environment > .env > mwh.toml [settings]
# > defaults. Keys are case-insensitive, unknown MWH_* keys are rejected (extra="forbid") so a
# typo fails loudly, an empty value means "use the default", relative paths are anchored at this
# folder, and list values are JSON. Every line below shows the default and is commented out —
# uncomment only what you change. `uv run mwh paths` shows which source supplied data_root;
# `uv run mwh doctor` reports which sources are in use.

# Data root outside the repository — local fixed NTFS/ReFS volume only; never G:/D:, never a
# synced/virtual/network drive or OneDrive (D-29; refused by the safety validators).
# MWH_DATA_ROOT=C:\mimicdata

# Raw PhysioNet CSVs; only ever tested for existence by this package (D-30).
# MWH_SOURCE_ROOT=..\source material

# Tier used when a command does not name one: fixture | demo | dev | full (D-18).
# MWH_DEFAULT_TIER=dev

# DuckDB — explicit in every process (DESIGN §6). Build profile / app profile memory limits.
# MWH_DUCKDB_MEMORY_LIMIT=36GB
# MWH_DUCKDB_APP_MEMORY_LIMIT=12GB
# MWH_DUCKDB_THREADS=12
# Spill directory; empty = <data_root>\tmp\duckdb. Must be on the data-root volume.
# MWH_DUCKDB_TEMP_DIR=
# MWH_DUCKDB_MAX_TEMP_SIZE=150GB

# Free-space guard: `mwh paths --create` (now) and `mwh build` (EP-19) refuse below this (DESIGN §3).
# MWH_MIN_FREE_GB=100

# Small-cell threshold used by safe_query / disclose (D-31, D-33). Do not lower.
# MWH_K_SUPPRESSION=11

# Remote/network calls from text modules; GOVERNANCE §9 wants false. Doctor warns when true.
# MWH_ALLOW_REMOTE=false

# Drive letters that may never hold warehouse data (Google Drive stream, Cryptomator; D-29).
# MWH_FORBIDDEN_DRIVES=["G","D"]

# Subject buckets (subject_id % 100) that make up the 5 % dev tier (D-18).
# MWH_DEV_BUCKETS=[0,1,2,3,4]
