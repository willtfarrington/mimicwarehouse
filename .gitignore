.uv/
__marimo__/
.ipynb_checkpoints/
*.ipynb
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.log
tmp/
.tmp/

# =============================================================================
# Claude Code: the repo-shared .claude/settings.json IS tracked (deny rules,
# GOVERNANCE §4); personal overrides are not.
# =============================================================================
.claude/settings.local.json

